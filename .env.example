# ─────────────────────────────────────────
#  PostgreSQL
# ─────────────────────────────────────────
POSTGRES_USER=events
POSTGRES_PASSWORD=events_dev_password
POSTGRES_DB=events_platform
POSTGRES_PORT=5433
DATABASE_URL=postgresql://events:events_dev_password@localhost:5433/events_platform

# ─────────────────────────────────────────
#  Redis
# ─────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────
#  Backend (Hono)
# ─────────────────────────────────────────
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=replace_with_random_32_byte_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────
#  Frontend (Vite)
# ─────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# ─────────────────────────────────────────
#  Email (для сповіщень)
# ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@events-platform.local
